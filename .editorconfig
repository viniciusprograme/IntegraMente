# EditorConfig ajuda a manter estilos de codificação consistentes
# entre múltiplos desenvolvedores trabalhando no mesmo projeto
# e em diferentes IDEs/editores.
# https://editorconfig.org

root = true

# Todos os arquivos
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Arquivos JavaScript/Node.js
[*.{js,jsx,json}]
indent_style = space
indent_size = 2

# Arquivos HTML/CSS
[*.{html,css,scss,sass}]
indent_style = space
indent_size = 2

# Arquivos Markdown
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# Arquivos YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
