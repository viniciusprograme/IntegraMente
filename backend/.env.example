# ============================================
# Configurações IntegraMente Backend
# ============================================

# 🔒 Segurança
# Gerar com: openssl rand -base64 32
JWT_SECRET=gere_uma_chave_complexa_com_64_caracteres_minimo

# 📡 Servidor
PORT=5000
NODE_ENV=development
HOST=localhost

# 🌐 CORS - URLs permitidas para requisições
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# 💾 Banco de Dados
# Deixar comentado para usar SQLite padrão
# DATABASE_URL=postgresql://user:password@localhost:5432/integramente

# 📧 Email (opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=sua_senha_de_app

# 📊 Logging
LOG_LEVEL=info
