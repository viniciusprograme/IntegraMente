{
  "name": "integramente",
  "version": "1.0.0",
  "description": "Plataforma IntegraMente de Saúde Mental",
  "private": true,
  "scripts": {
    "start": "concurrently \"cd backend && npm start\" \"cd frontend && npx http-server -p 3000 --spa\"",
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npx http-server -p 3000 --spa\"",
    "backend:start": "cd backend && npm start",
    "backend:dev": "cd backend && npm run dev",
    "frontend:start": "cd frontend && npx http-server -p 3000",
    "frontend:spa": "cd frontend && npx http-server -p 3000 --spa",
    "docker:up": "cd docker && docker compose up -d",
    "docker:down": "cd docker && docker compose down",
    "docker:logs": "cd docker && docker compose logs -f",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "keywords": [
    "saude-mental",
    "integramente",
    "bem-estar"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
